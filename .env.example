# ──────────────────────────────────────────────────────────────
# HPHII SHR / DSP — environment template. Copy to `.env` and adjust.
# NEVER commit a real `.env` (see .gitignore). Secrets only via env.
# ──────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development

# --- HAPI FHIR repository (the clinical data store) ---
HAPI_FHIR_BASE_URL=http://localhost:8080/fhir

# --- Postgres backing HAPI (consumed by docker-compose) ---
POSTGRES_HAPI_DB=hapi
POSTGRES_HAPI_USER=hapi
POSTGRES_HAPI_PASSWORD=hapi

# --- Postgres for the gateway (users/roles/sessions/MFA/audit mirror) ---
# NO clinical data here — clinical data lives in HAPI.
POSTGRES_GATEWAY_DB=gateway
POSTGRES_GATEWAY_USER=gateway
POSTGRES_GATEWAY_PASSWORD=gateway
# Prisma connection string (host port 5433 maps to the container's 5432).
GATEWAY_DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway?schema=public

# --- Redis (BullMQ — the 15-min escalation queue) ---
REDIS_URL=redis://localhost:6379

# --- Gateway API ---
GATEWAY_PORT=3000

# --- Auth: OAuth2 password grant + JWT (RS256) + TOTP MFA ---
# RS256 key pair generated locally into ./secrets (gitignored). See README.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=hphii-shr
# Access token lifetime in seconds (900 = 15 min).
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (2592000 = 30 days).
JWT_REFRESH_TTL=2592000
# Label shown in authenticator apps for TOTP MFA.
MFA_ISSUER=HPHII-SHR

# --- SMS channel (pluggable; default logs to console) ---
SMS_PROVIDER=console
# Optional Twilio adapter (only used when SMS_PROVIDER=twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Monitoring / escalation (CLAUDE.md §8) ---
# Minutes before an unacknowledged high/critical alert escalates.
ALERT_ESCALATION_MINUTES=15
SENIOR_PHYSICIAN_PHONE=+212600000000

# --- Web app (Vite — exposed to the browser, so NEVER put secrets here) ---
VITE_API_BASE_URL=http://localhost:3000
